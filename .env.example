# Public URL of the deployed site (no trailing slash). REQUIRED in production:
# canonical URLs, Open Graph, sitemap.xml and robots.txt are built from it.
# Without it they fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Contact form (server-side only — never prefix these with NEXT_PUBLIC_).
# Messages are sent through the Resend API (https://resend.com).
# If any of these is missing, the form shows an honest "not active" message instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Faqja e shkollës <kontakt@yourdomain>"
CONTACT_FROM_EMAIL=

# Optional: Google Maps Embed API key (public, restrict it to your domain in Google Cloud).
# Without it, the keyless Google Maps embed is used.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
